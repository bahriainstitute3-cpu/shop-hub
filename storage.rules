rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images are public in the storefront, and any signed-in seller/admin
    // can upload new product images from the app.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // App branding/logo uploads remain admin-only.
    match /appAssets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'anusch2026@gmail.com' ||
        request.auth.token.email == 'bahriainstitute3@gmail.com'
      );
    }
  }
}
